# Nalopa School web app (Flutter + Drift/sql.js)

# sql.js and Flutter need the correct WebAssembly MIME type
<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType application/manifest+json .webmanifest
    AddType application/json .json
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/wasm
</IfModule>

<IfModule mod_headers.c>
    # Always fetch the latest app shell so new deploys are picked up
    <FilesMatch "^(index\.html|flutter_service_worker\.js|flutter_bootstrap\.js|version\.json|manifest\.json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    <FilesMatch "\.(wasm|png|jpg|jpeg|ico|svg|ttf|otf|woff2?)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    Header always set X-Content-Type-Options nosniff
</IfModule>
